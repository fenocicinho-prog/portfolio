# --- Base de données (déjà utilisée par le site) ---
DATABASE_URL=
IP_HASH_SALT=mets-une-longue-phrase-au-hasard

# --- Page /admin ---
ADMIN_PASSWORD=choisis-un-mot-de-passe-long
ADMIN_SECRET=une-autre-longue-phrase-au-hasard   # sert à signer la session (facultatif mais conseillé)

# --- Alertes Telegram ---
TELEGRAM_BOT_TOKEN=     # donné par @BotFather
TELEGRAM_CHAT_ID=       # ton identifiant (voir le guide)
PUBLIC_SITE_URL=https://ton-site.vercel.app   # pour le lien "Ouvrir l'admin" dans l'alerte

# --- Assistant du portfolio (OpenRouter) ---
OPENROUTER_API_KEY=     # clé conservée côté serveur, jamais exposée au navigateur
OPENROUTER_MODEL=openrouter/auto  # modèle rapide à choisir dans ton compte OpenRouter
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions  # facultatif
