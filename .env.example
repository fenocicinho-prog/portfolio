# OpenRouter powers natural, context-aware chatbot answers (keep the key server-side)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-4b:free
PUBLIC_SITE_URL=

# Database already used by the public contact and chat APIs
DATABASE_URL=
IP_HASH_SALT=

# Required to enable /admin (keep both values private)
# ADMIN_PASSWORD must be at least 16 characters
# ADMIN_SESSION_SECRET must be at least 32 characters
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Meta WhatsApp Cloud API (all credentials stay server-side)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: defaults to the WhatsApp number in content/site.ts; digits only
WHATSAPP_ADMIN_TO=
# Must match an approved Meta message template with five positional body parameters
WHATSAPP_TEMPLATE_NAME=portfolio_new_lead
WHATSAPP_TEMPLATE_LANGUAGE=fr
WHATSAPP_GRAPH_API_VERSION=v26.0
